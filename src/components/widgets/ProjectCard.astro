---
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'projects'>
  ogImage?: string | null
}

const { project, ogImage } = Astro.props
const { title, description, tags } = project.data
---

<a href={`/projects/${project.id}/`} class="project-card">
  <div class="project-content">
    <h3 class="project-title">{title}</h3>
    <p class="project-description">{description}</p>
    {
      tags && tags.length > 0 && (
        <div class="project-tags">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }
  </div>
  {ogImage && (
    <div class="project-image">
      <img src={ogImage} alt={title} />
    </div>
  )}
</a>

<style>
  .project-card {
    position: relative;
    display: flex;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    text-decoration: none;
    color: var(--text-primary);
    overflow: hidden;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }

  .project-card:hover {
    border-color: var(--text-secondary);
    transform: translateY(-2px);
  }

  .project-content {
    flex: 1;
    z-index: 1;
    position: relative;
  }

  .project-image {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 50%;
    opacity: 0.3;
    pointer-events: none;
  }

  .project-image::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background: linear-gradient(
      to right,
      var(--bg) 0%,
      transparent 60%
    );
    z-index: 1;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-title {
    margin: 0 0 0.5rem 0;
    font-size: 1.25rem;
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
  }

  .project-description {
    margin: 0 0 1rem 0;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.875rem;
    padding: 0.25rem 0.75rem;
    background-color: var(--background-secondary, var(--background));
    color: var(--text-tertiary);
    border-radius: 0.25rem;
    border: 1px solid var(--border);
  }
</style>
