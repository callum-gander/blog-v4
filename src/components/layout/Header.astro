---
import ThemeToggle from '@/components/ui/ThemeToggle.astro'
---

<header>
  <nav>
    <!-- <a href="/">{themeConfig.site.title}</a> -->
    <div class="nav-links">
      <a href="/">home</a>
      <span class="separator">/</span>
      <a href="/blog">blog</a>
      <span class="separator">/</span>
      <a href="/work">work</a>
      <span class="separator">/</span>
      <a href="/projects">projects</a>
      <span class="separator">/</span>
      <a href="/cv/CV 2023-2.pdf" download>cv</a>
    </div>
    <ThemeToggle />
  </nav>
</header>
<style>
  header {
    margin: 0;
  }
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  header a {
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    text-decoration: none;
    min-width: 3rem;
    display: inline-block;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .nav-links a {
    min-width: auto;
    transition: opacity 0.2s;
  }
  .nav-links a:hover {
    opacity: 0.7;
  }
  .separator {
    color: var(--text-secondary, #888);
    user-select: none;
  }
</style>
